# Canonical origin for metadata, sitemap.xml, robots.txt and OG tags.
# On Vercel this is inferred from VERCEL_PROJECT_PRODUCTION_URL; set it
# explicitly when using a custom domain.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Contact form POST target (e.g. https://formspree.io/f/xxxxxxxx).
# Leave unset to have the form open a pre-filled email instead.
NEXT_PUBLIC_FORM_ENDPOINT=
